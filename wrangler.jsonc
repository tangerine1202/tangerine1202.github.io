// Production: blog.alans.dev, the built site as Workers static assets (no Worker code).
// Deploy with ./deploy.sh, which builds into .deploy/site first.
{
  "name": "meanwhile",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./.deploy/site",
    // Any address with no page gets 404.html, with a 404 status.
    "not_found_handling": "404-page"
  },
  // blog.alans.dev is the one address: no meanwhile.<account>.workers.dev, no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "blog.alans.dev", "custom_domain": true }]
}
